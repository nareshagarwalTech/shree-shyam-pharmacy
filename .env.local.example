# --- Supabase (required) ---
# Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # server-only, never client-exposed

# --- AiSensy / WhatsApp Business API (required for server-side sending) ---
# AiSensy → Manage → API Key (long JWT-like string)
AISENSY_API_KEY=

# AiSensy → Campaigns → name of your approved utility template campaign
# Default (English). Add per-language campaigns to enable multi-language sends.
AISENSY_CAMPAIGN_NAME=refill_reminder_en
AISENSY_CAMPAIGN_EN=refill_reminder_en
AISENSY_CAMPAIGN_TE=
AISENSY_CAMPAIGN_HI=

# Webhook verification — pick any random string and set the same value in
# AiSensy → Webhooks → Verify Token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
