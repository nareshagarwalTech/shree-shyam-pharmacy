# --- Supabase (required) ---
# Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # server-only, never client-exposed

# --- Dashboard password (required) ---
# Server-only. NOT prefixed with NEXT_PUBLIC_ on purpose: this string is
# checked inside the /api/login route handler and never shipped to the
# browser. Pick something stronger than the default — every staff member
# shares this one password.
APP_PASSWORD=change-me

# --- WhatsApp ---
# We use wa.me click-to-chat (free, manual). Staff opens WhatsApp on their
# device, sends the message, then clicks "Mark Sent" in /dashboard/whatsapp
# to record the send. No third-party API integration is required.
